# Database
DATABASE_URL="postgresql://user:password@localhost:5432/issuescash?schema=public"

# GitHub Webhook
# Generate a random secret: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET="your-webhook-secret-here"

# Bitcoin Cash Network (for server-side operations: webhooks, contract creation)
# Options: "mainnet" or "testnet3"
BCH_NETWORK="testnet3"

# Website Network Filter (for user-facing pages)
# Filters which bounties are displayed on the website
# Options: "mainnet" or "testnet3" (defaults to "mainnet" if not set)
NEXT_PUBLIC_BCH_NETWORK="mainnet"

# GitHub Authentication (choose ONE method)
#
# Option 1: Personal Access Token (simpler, for single user/org)
# Create at: https://github.com/settings/tokens/new
# Required scopes: repo (for private repos) or public_repo (for public repos only)
GITHUB_TOKEN="ghp_your_token_here"
#
# Option 2: GitHub App (recommended for production, better rate limits)
# Create at: https://github.com/settings/apps/new
# The installation ID is automatically extracted from webhook payloads
# Required permissions: Issues (read & write), Pull requests (read)
# GITHUB_APP_ID="123456"
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYour private key here...\n-----END RSA PRIVATE KEY-----"

# ============================================================================
# GitLab Integration (Optional)
# ============================================================================
#
# GitLab uses Trust-On-First-Use (TOFU) for credentials.
# Each project configures its webhook secret in GitLab's webhook settings.
# The secret format is: "secret|token" or just "secret"
#   - secret: Used to verify webhook authenticity
#   - token: Optional GitLab access token for posting comments
#
# Example: "mysecret123|glpat-xxxxxxxxxxxxxxxxxxxx"
#
# No server-side GitLab configuration needed - credentials are stored
# per-project in the database when the first webhook is received.
#
# GitLab Instance URL (optional, defaults to https://gitlab.com)
# Set this for self-hosted GitLab instances
# GITLAB_INSTANCE_URL="https://gitlab.mycompany.com"

# ============================================================================
# Commission Settings (Optional)
# ============================================================================
#
# Commission rate in basis points (100 = 1%, 150 = 1.5%, 10000 = 100%)
# Default: 0 (no commission)
# Commission is only charged on successful bounty completions, not refunds/expiry.
# COMMISSION_BPS=150
#
# Zero-commission projects (founding partners)
# Comma-separated list of projects that pay 0% commission regardless of global rate.
# Format: "github:owner/repo,gitlab:owner/repo"
# ZERO_COMMISSION_PROJECTS="github:myorg/myrepo,gitlab:anotherorg/anotherrepo"
